{
  "name": "returncheck",
  "version": "1.0.0",
  "description": "Camera rental damage settlement: PayPal Vault, Claude photo comparison, approval-pending charges, AG Studio fleet dashboard",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "demo:video": "npm run build && FORCE_MOCK=1 PORT=3010 node server/index.js",
    "demo:sandbox": "npm run build && node server/index.js",
    "sandbox:token": "python3 scripts/save-demo-token.py",
    "record:runs": "node scripts/record-runs.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "test": "FORCE_MOCK=1 node --test test/*.test.js",
    "photoset:check": "node scripts/seed-photo-set-a.js --check",
    "photoset:a": "node scripts/seed-photo-set-a.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/sdk": "^1.8.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "ag-studio": "^3.1.0",
    "ag-studio-react": "^3.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
