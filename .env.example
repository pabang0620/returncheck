# Leave everything empty to run on doubles: no PayPal, Anthropic or other external calls are made.
PORT=3010
PUBLIC_URL=http://localhost:3010

# Claude (server only). Empty = recorded results for the preloaded photo pairs and the Studio agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local development only: LLM_BACKEND=account runs Claude through your Claude Code login (Claude Agent SDK),
# never through an API key. Any ANTHROPIC_API_KEY is stripped from the child process. Default (empty) = API key or recorded.
LLM_BACKEND=

# PayPal sandbox app credentials. Empty = mock PayPal with the same response shapes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox payment token saved once for the judge demo. It can be charged by every session and is never deleted.
DEMO_VAULT_TOKEN_ID=DEMO-SHARED-TOKEN
# SANDBOX_BUYER_EMAIL is shown to judges for "Save PayPal yourself" (a fake sandbox account).
SANDBOX_BUYER_EMAIL=

# vault (default) or invoice (plan 6-5 fallback: no PayPal saved at pickup, charges go out as PayPal invoices)
PAYMENT_MODE=vault

# Live model caps. A run = one user action. Over a cap, or on any model error, the app uses the recorded run or the rule-based stand-in and says why.
LLM_LIVE_PER_IP_HOUR=10
LLM_LIVE_PER_DAY=150
# Express trust proxy (loopback = nginx on this machine) so the per-IP cap sees the real visitor.
TRUST_PROXY=loopback

MAX_SESSIONS=300
SESSION_TTL_MS=21600000

# FORCE_MOCK=1 ignores any keys above (used by tests).
# Build-time only: trial licence key for AG Studio (removes the watermark). Put it in client env as VITE_AG_STUDIO_LICENSE_KEY.
